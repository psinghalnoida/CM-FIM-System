// CM FIM System — Prisma schema.
//
// M2a: org/city/depot/vehicle/driver master data, users, the document
// repository (versioned, with OCR), incidents, evidence, telematics
// snapshots, activity timeline, audit log, and the human-readable-ID
// counter.
//
// M2b (this revision) adds: insurance policies, claims, surveys,
// workshop/repair jobs, the TAT engine, and settlement/payment — see
// docs/SCOPE.md and docs/schema/M2B.md.
//
// Design notes (see docs/SCOPE.md §5 "Adapter interface contracts" and
// docs/RULES.md for the business rules driving these choices):
// - Human-readable IDs (INC-2026-000001, CLM-2026-000001, SUR-2026-000001,
//   ...) are generated by the application via IdCounter, inside the same
//   transaction as the insert — not by a DB trigger/sequence. See
//   IdCounter below.
// - DocumentLink is a generic (documentId, linkedEntityType, linkedEntityId)
//   join with no DB-level FK on linkedEntityId, because a document can
//   attach to many different entity types. Referential integrity for that
//   link is enforced in the domain-documents service layer, not the
//   database.
// - AuditLog.entityId is likewise generic/no-FK for the same reason: it
//   must be able to reference any auditable entity in the system.
// - CaseStageInstance and ActivityTimelineEvent are different: each has
//   only two possible parents (Incident or Claim), so they use a real
//   nullable-FK-per-parent pair (DB-enforced) plus a CHECK constraint
//   requiring exactly one to be set, rather than a generic reference. See
//   docs/schema/M2B.md for why this is a different call than DocumentLink.
// - Money columns carry an explicit `currency` (default "INR") rather than
//   assuming a single hardcoded currency, consistent with the org_id-
//   everywhere multi-tenancy stance in docs/SCOPE.md.
//
// M3 adds: Session (database-backed sessions — see docs/AUTH.md for the
// full auth design: hand-rolled DB sessions + encrypted cookie + DAL, per
// this Next.js version's own recommended pattern).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & org structure
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique // short human code, e.g. "JBM"
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities             City[]
  depots             Depot[]
  users              User[]
  vehicles           Vehicle[]
  drivers            Driver[]
  documents          Document[]
  incidents          Incident[]
  idCounters         IdCounter[]
  auditLogs          AuditLog[]
  insurancePolicies  InsurancePolicy[]
  claims             Claim[]
  surveys            Survey[]
  repairJobs         RepairJob[]
  tatStageTemplates  TatStageTemplate[]
  caseStageInstances CaseStageInstance[]
  escalationRules    EscalationRule[]
  escalationEvents   EscalationEvent[]
  settlements        Settlement[]
  insurers           Insurer[]
  brokers            Broker[]
  surveyors          Surveyor[]
  workshops          Workshop[]
  warranties         Warranty[]

  @@map("organizations")
}

model City {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  state          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  depots Depot[]

  @@unique([organizationId, name])
  @@map("cities")
}

model Depot {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  cityId         String
  city           City         @relation(fields: [cityId], references: [id])
  code           String
  name           String
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users     User[]
  vehicles  Vehicle[]
  drivers   Driver[]
  incidents Incident[]

  @@unique([organizationId, code])
  @@map("depots")
}

enum UserRole {
  SUPER_ADMIN // cross-org, support only
  ORG_ADMIN
  DEPOT_MANAGER
  CLAIMS_MANAGER
  SURVEYOR
  WORKSHOP_COORDINATOR
  FINANCE_OFFICER
  AUDITOR // read-only, full audit-log access
  WHATSAPP_BOT // system principal for inbound-message-created incidents
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  depotId        String?
  depot          Depot?       @relation(fields: [depotId], references: [id])
  name           String
  email          String       @unique
  phone          String?
  // Auth mechanics (hashing, sessions) are implemented in M3 — this column
  // exists now so the rest of the schema can reference User by FK today.
  passwordHash   String?
  role           UserRole
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  uploadedDocumentVersions  DocumentVersion[]       @relation("DocumentVersionUploadedBy")
  verifiedOcrExtractions    OcrExtraction[]         @relation("OcrExtractionVerifiedBy")
  createdDocuments          Document[]              @relation("DocumentCreatedBy")
  reportedIncidents         Incident[]              @relation("IncidentReportedBy")
  uploadedEvidence          Evidence[]              @relation("EvidenceUploadedBy")
  timelineEvents            ActivityTimelineEvent[] @relation("ActivityTimelineEventActor")
  auditLogEntries           AuditLog[]              @relation("AuditLogActor")
  assignedClaims            Claim[]                 @relation("ClaimAssignedTo")
  linkedSurveyorProfiles    Surveyor[]              @relation("SurveyorLinkedUser")
  workshopActivities        WorkshopActivity[]      @relation("WorkshopActivityActor")
  createdTatHoldPeriods     TatHoldPeriod[]         @relation("TatHoldPeriodCreatedBy")
  notifiedByEscalationRules EscalationRule[]        @relation("EscalationRuleNotifyUser")
  respondedSettlements      Settlement[]            @relation("SettlementRespondedBy")
  reconciledPayments        Payment[]               @relation("PaymentReconciledBy")
  sessions                  Session[]

  @@map("users")
}

// Database-backed session (see docs/AUTH.md). The browser only ever holds
// an encrypted cookie containing this row's id — never the row's contents
// directly — so a session can be revoked (revokedAt) without waiting for
// the cookie to expire.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Vehicle & driver master data
// ---------------------------------------------------------------------------

enum VehicleType {
  TRUCK
  TRAILER
  BUS
  CAR
  TWO_WHEELER
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  SOLD
  SCRAPPED
}

model Vehicle {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id])
  depotId            String
  depot              Depot         @relation(fields: [depotId], references: [id])
  registrationNumber String
  chassisNumber      String?
  engineNumber       String?
  make               String?
  model              String?
  vehicleType        VehicleType   @default(OTHER)
  manufactureYear    Int?
  registrationDate   DateTime?
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  incidents         Incident[]
  insurancePolicies InsurancePolicy[]
  warranties        Warranty[]

  @@unique([organizationId, registrationNumber])
  @@map("vehicles")
}

// M28: the Vehicle Detail page's Warranty tab. Basic terms only — a
// human-readable provider (free text, same Phase-1 pattern as
// InsurancePolicy.insurerName before M27, not a master table: nothing
// asked for a "warranty provider master," unlike Insurer/Surveyor/
// Workshop which M27 built because free text on live records already
// existed and the design named them explicitly) plus a coverage
// description and a validity window. Multiple rows per vehicle are
// allowed — a real vehicle can carry more than one warranty at once
// (e.g. the manufacturer's original warranty and a separately-purchased
// extended one) — this is not a one-to-one relationship. See
// docs/MASTERS.md's M28 section.
model Warranty {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  provider             String
  coverageDescription  String?
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([vehicleId])
  @@map("warranties")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Driver {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  depotId           String
  depot             Depot        @relation(fields: [depotId], references: [id])
  name              String
  licenseNumber     String
  licenseExpiryDate DateTime?
  phone             String?
  status            DriverStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  incidents Incident[]

  @@unique([organizationId, licenseNumber])
  @@map("drivers")
}

// ---------------------------------------------------------------------------
// Insurance policies (BR-05: the policy applicable on the incident date is
// auto-selected — this table is what that selection queries against)
// ---------------------------------------------------------------------------

enum PolicyType {
  COMPREHENSIVE
  THIRD_PARTY
  STANDALONE_OD // "own damage" only, paired with a separate third-party policy
  OTHER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// M27: master data — formalizes what was free text (InsurancePolicy.
// insurerName) into a real, admin-managed entity. See docs/MASTERS.md's
// M27 section for the backfill plan (existing distinct insurerName
// values become Insurer rows; insurerId then replaces insurerName
// outright, not alongside it).
model Insurer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  policies InsurancePolicy[]

  @@unique([organizationId, name])
  @@map("insurers")
}

// M27: unlike Insurer/Surveyor/Workshop, nothing in this schema
// referenced a broker before this milestone — no free text to migrate,
// no existing gap. Added because the design's Master Data screen lists
// it; attaches to InsurancePolicy (the natural place — a broker
// facilitates a policy) as an optional field, since not every policy
// goes through one.
model Broker {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  policies InsurancePolicy[]

  @@unique([organizationId, name])
  @@map("brokers")
}

model InsurancePolicy {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  // Phase 1 models one policy per vehicle. Fleet/blanket policies covering
  // multiple vehicles aren't represented here yet — deferred until there's
  // a real JBM policy document to design against, rather than guessed at.
  vehicleId         String
  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id])
  policyNumber      String
  insurerId         String
  insurer           Insurer      @relation(fields: [insurerId], references: [id])
  // Optional — not every policy is placed through a broker.
  brokerId          String?
  broker            Broker?      @relation(fields: [brokerId], references: [id])
  policyType        PolicyType   @default(COMPREHENSIVE)
  coverageStartDate DateTime
  coverageEndDate   DateTime
  premiumAmount     Decimal?     @db.Decimal(14, 2)
  sumInsuredAmount  Decimal?     @db.Decimal(14, 2)
  currency          String       @default("INR") @db.Char(3)
  status            PolicyStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  claims Claim[]

  @@unique([organizationId, policyNumber])
  // BR-05's query shape: "the policy covering this vehicle whose coverage
  // window contains the incident date".
  @@index([vehicleId, coverageStartDate, coverageEndDate])
  @@map("insurance_policies")
}

// ---------------------------------------------------------------------------
// Document repository (BR-04: versioned; BR-07: OCR never silently
// overwrites master data)
// ---------------------------------------------------------------------------

enum DocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE_POLICY
  FITNESS_CERTIFICATE
  PERMIT
  PUC_CERTIFICATE
  DRIVING_LICENSE
  REPAIR_ESTIMATE
  OTHER
}

model Document {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  documentType       DocumentType
  title              String
  // Points at the active version; versions themselves are append-only (see
  // DocumentVersion below). Nullable because the first version is created
  // in a follow-up step within the same transaction as the Document row.
  currentVersionId   String?          @unique
  currentVersion     DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  // Validity window for documents that expire (insurance, permit, PUC, ...);
  // null for document types that don't have one.
  validityStartDate  DateTime?
  validityExpiryDate DateTime?
  createdById        String
  createdBy          User             @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  versions DocumentVersion[] @relation("DocumentVersions")
  links    DocumentLink[]

  @@index([organizationId, documentType])
  @@index([validityExpiryDate])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation("DocumentVersions", fields: [documentId], references: [id])
  versionNumber  Int
  storageBucket  String
  storageKey     String
  fileName       String
  mimeType       String
  fileSizeBytes  Int
  checksumSha256 String?
  uploadedById   String
  uploadedBy     User     @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  // Reverse side of Document.currentVersion (see above).
  currentForDocument Document?      @relation("DocumentCurrentVersion")
  ocrExtraction      OcrExtraction?

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

enum OcrStatus {
  PENDING
  EXTRACTED
  VERIFIED
  REJECTED
}

model OcrExtraction {
  id                    String          @id @default(uuid())
  documentVersionId     String          @unique
  documentVersion       DocumentVersion @relation(fields: [documentVersionId], references: [id])
  provider              String // e.g. "aws-textract"
  status                OcrStatus       @default(PENDING)
  // Array of { key, value, confidence } — proposed values only; never
  // applied to master data without human verification (BR-07).
  extractedFields       Json?
  rawResponseStorageKey String?
  verifiedById          String?
  verifiedBy            User?           @relation("OcrExtractionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("ocr_extractions")
}

enum LinkedEntityType {
  VEHICLE
  DRIVER
  INCIDENT
  // Not yet backed by a table (added in M2b) — the enum already supports
  // linking documents to them so DocumentLink doesn't need to change shape
  // when those tables land.
  POLICY
  CLAIM
  SURVEY
  REPAIR_JOB
  SETTLEMENT
}

model DocumentLink {
  id               String           @id @default(uuid())
  documentId       String
  document         Document         @relation(fields: [documentId], references: [id])
  linkedEntityType LinkedEntityType
  linkedEntityId   String // no DB FK — see schema-level note at top of file
  createdAt        DateTime         @default(now())

  @@index([linkedEntityType, linkedEntityId])
  @@map("document_links")
}

// ---------------------------------------------------------------------------
// Incidents (BR-01: the parent record)
// ---------------------------------------------------------------------------

enum IncidentType {
  ACCIDENT
  THEFT
  FIRE
  BREAKDOWN
  NATURAL_DISASTER
  THIRD_PARTY_DAMAGE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  CLOSED
}

enum ReportedVia {
  WEB
  WHATSAPP
  MOBILE_APP
  PHONE
  OTHER
}

model Incident {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  incidentNumber     String // human-readable, e.g. INC-2026-000001 (see IdCounter)
  vehicleId          String
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id])
  driverId           String?
  driver             Driver?          @relation(fields: [driverId], references: [id])
  depotId            String
  depot              Depot            @relation(fields: [depotId], references: [id])
  incidentDateTime   DateTime // when the incident actually happened — drives policy auto-selection (BR-05)
  reportedAt         DateTime         @default(now()) // when it was logged in the system
  reportedById       String?
  reportedBy         User?            @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  reportedVia        ReportedVia      @default(WEB)
  incidentType       IncidentType
  severity           IncidentSeverity @default(MEDIUM)
  locationAddress    String?
  locationLat        Float?
  locationLng        Float?
  description        String
  // M21: the design's Incident Overview tab shows these as structured
  // fields (not just free text buried in `description`) — both nullable,
  // filled in as the picture becomes clearer, not required at intake.
  injuries           String?
  thirdPartyInvolved Boolean?
  status             IncidentStatus   @default(OPEN)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  evidence           Evidence[]
  telematicsSnapshot TelematicsSnapshot?
  timelineEvents     ActivityTimelineEvent[]
  claims             Claim[]
  caseStageInstances CaseStageInstance[]

  @@unique([organizationId, incidentNumber])
  @@index([organizationId, status])
  @@map("incidents")
}

enum EvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
}

model Evidence {
  id            String       @id @default(uuid())
  incidentId    String
  incident      Incident     @relation(fields: [incidentId], references: [id])
  evidenceType  EvidenceType
  storageBucket String
  storageKey    String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  caption       String?
  uploadedById  String?
  uploadedBy    User?        @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt    DateTime     @default(now())

  @@index([incidentId])
  @@map("evidence")
}

// BR-06: captured once at incident-report time, immutable afterward.
model TelematicsSnapshot {
  id                 String   @id @default(uuid())
  incidentId         String   @unique
  incident           Incident @relation(fields: [incidentId], references: [id])
  providerName       String // e.g. "stub", "jbm-fms" — see domain-telematics adapter
  vehicleExternalId  String // the provider's identifier for the vehicle
  capturedAt         DateTime
  speedKmh           Float?
  latitude           Float?
  longitude          Float?
  ignitionOn         Boolean?
  odometerKm         Float?
  harshBrakingEvents Int?
  rawPayload         Json // full raw provider response, for future-proofing
  createdAt          DateTime @default(now())

  @@map("telematics_snapshots")
}

// Communication/activity timeline for an incident or a claim. Exactly one
// of incidentId/claimId is set — enforced by a CHECK constraint added by
// hand to the M2b migration (see docs/schema/M2B.md), since Prisma has no
// declarative syntax for it yet.
model ActivityTimelineEvent {
  id          String    @id @default(uuid())
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id])
  claimId     String?
  claim       Claim?    @relation(fields: [claimId], references: [id])
  eventType   String // e.g. "STATUS_CHANGE", "WHATSAPP_MESSAGE", "NOTE"
  actorId     String?
  actor       User?     @relation("ActivityTimelineEventActor", fields: [actorId], references: [id])
  description String
  metadata    Json?
  occurredAt  DateTime  @default(now())

  @@index([incidentId, occurredAt])
  @@index([claimId, occurredAt])
  @@map("activity_timeline_events")
}

// ---------------------------------------------------------------------------
// Claims (BR-02/BR-03: derived from an incident, no duplicate data entry;
// an incident may have multiple claims)
// ---------------------------------------------------------------------------

enum ClaimType {
  INSURANCE
  WARRANTY
  MAINTENANCE
  OPERATIONAL
  THIRD_PARTY_RECOVERY
  MIXED
}

enum ClaimStatus {
  OPEN
  UNDER_SURVEY
  UNDER_REPAIR
  PENDING_SETTLEMENT
  SETTLED
  CLOSED
  REJECTED
}

model Claim {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  claimNumber    String // human-readable, e.g. CLM-2026-000001 (see IdCounter)
  incidentId     String
  incident       Incident         @relation(fields: [incidentId], references: [id])
  claimType      ClaimType
  // Set only for INSURANCE/MIXED claims, auto-selected per BR-05. Nullable
  // because WARRANTY/MAINTENANCE/OPERATIONAL/THIRD_PARTY_RECOVERY claims
  // have no policy.
  policyId       String?
  policy         InsurancePolicy? @relation(fields: [policyId], references: [id])
  status         ClaimStatus      @default(OPEN)
  assignedToId   String?
  assignedTo     User?            @relation("ClaimAssignedTo", fields: [assignedToId], references: [id])
  openedAt       DateTime         @default(now())
  closedAt       DateTime? // BR-09 (closure gate) is enforced in the domain-claims service, not here
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  surveys            Survey[]
  repairJobs         RepairJob[]
  timelineEvents     ActivityTimelineEvent[]
  caseStageInstances CaseStageInstance[]
  settlements        Settlement[]

  @@unique([organizationId, claimNumber])
  @@index([incidentId])
  @@index([organizationId, status])
  @@map("claims")
}

// ---------------------------------------------------------------------------
// Surveys
// ---------------------------------------------------------------------------

enum SurveyStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// M27: master data — formalizes what was free text (Survey.surveyorName/
// surveyorContact/surveyorUserId) into a real, admin-managed entity.
// Surveyors are often external agency reps, not app Users — contact info
// is always captured on the Surveyor row itself now (was per-Survey
// before, duplicated across every survey the same person did);
// linkedUserId is set only when they're internal, moved here from
// Survey.surveyorUserId for the same reason — "is this an internal
// user" is a property of the surveyor, not of one particular survey.
// See docs/MASTERS.md's M27 section for the backfill plan.
model Surveyor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  contact        String?
  linkedUserId   String?
  linkedUser     User?        @relation("SurveyorLinkedUser", fields: [linkedUserId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  surveys Survey[]

  @@unique([organizationId, name])
  @@map("surveyors")
}

model Survey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  surveyNumber   String // human-readable, e.g. SUR-2026-000001 (see IdCounter)
  claimId        String
  claim          Claim        @relation(fields: [claimId], references: [id])
  surveyorId     String
  surveyor       Surveyor     @relation(fields: [surveyorId], references: [id])
  status         SurveyStatus @default(SCHEDULED)
  scheduledAt    DateTime?
  conductedAt    DateTime?
  findings       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, surveyNumber])
  @@index([claimId])
  @@index([surveyorId])
  @@map("surveys")
}

// ---------------------------------------------------------------------------
// Workshop & repair tracking
// ---------------------------------------------------------------------------

enum RepairJobStatus {
  ESTIMATE_PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// M27: master data — formerly free text on RepairJob (workshopName/
// workshopContact/workshopAddress), same reasoning as Surveyor above:
// contact/address are properties of the workshop itself, not
// re-entered per repair job. Was Phase-1 free text deliberately — see
// docs/schema/M2B.md's original note — formalized here once the design
// actually asked for a Master Data screen managing it. See
// docs/MASTERS.md's M27 section for the backfill plan.
model Workshop {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  contact        String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  repairJobs RepairJob[]

  @@unique([organizationId, name])
  @@map("workshops")
}

model RepairJob {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  claimId        String
  claim          Claim           @relation(fields: [claimId], references: [id])
  workshopId     String
  workshop       Workshop        @relation(fields: [workshopId], references: [id])
  estimatedCost  Decimal?        @db.Decimal(14, 2)
  approvedCost   Decimal?        @db.Decimal(14, 2)
  actualCost     Decimal?        @db.Decimal(14, 2)
  currency       String          @default("INR") @db.Char(3)
  status         RepairJobStatus @default(ESTIMATE_PENDING)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  activities WorkshopActivity[]
  parts      RepairPart[]

  @@index([claimId])
  @@index([workshopId])
  @@map("repair_jobs")
}

// M19: the design's Repair Detail "Parts" tab — a simple named-parts list,
// not a parts-catalog/inventory system (no cost/qty tracking asked for).
model RepairPart {
  id          String    @id @default(uuid())
  repairJobId String
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
  partName    String
  createdAt   DateTime  @default(now())

  @@index([repairJobId])
  @@map("repair_parts")
}

model WorkshopActivity {
  id           String    @id @default(uuid())
  repairJobId  String
  repairJob    RepairJob @relation(fields: [repairJobId], references: [id])
  activityType String // e.g. "ESTIMATE_SUBMITTED", "PARTS_ORDERED", "QC_CHECK", "HANDOVER"
  notes        String?
  actorId      String?
  actor        User?     @relation("WorkshopActivityActor", fields: [actorId], references: [id])
  occurredAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([repairJobId, occurredAt])
  @@map("workshop_activities")
}

// ---------------------------------------------------------------------------
// TAT engine (PR-01: configurable per stage; PR-02: hold periods;
// PR-03: automatic, configurable escalation)
// ---------------------------------------------------------------------------

enum CaseType {
  INCIDENT
  INSURANCE_CLAIM
  WARRANTY_CLAIM
  MAINTENANCE_CLAIM
  OPERATIONAL_CLAIM
  THIRD_PARTY_RECOVERY_CLAIM
  MIXED_CLAIM
}

model TatStageTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  caseType       CaseType
  stageKey       String // machine key, e.g. "SURVEY_SCHEDULING"
  stageName      String // display name
  sequenceOrder  Int
  targetHours    Int // the configurable TAT target for this stage
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  caseStageInstances CaseStageInstance[]
  escalationRules    EscalationRule[]

  @@unique([organizationId, caseType, stageKey])
  @@map("tat_stage_templates")
}

enum CaseStageStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

// One row per (incident or claim) x workflow stage. Exactly one of
// incidentId/claimId is set — enforced by a CHECK constraint added by hand
// to the M2b migration (see docs/schema/M2B.md).
model CaseStageInstance {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  incidentId      String?
  incident        Incident?        @relation(fields: [incidentId], references: [id])
  claimId         String?
  claim           Claim?           @relation(fields: [claimId], references: [id])
  stageTemplateId String
  stageTemplate   TatStageTemplate @relation(fields: [stageTemplateId], references: [id])
  status          CaseStageStatus  @default(PENDING)
  enteredAt       DateTime         @default(now())
  // Computed at creation (enteredAt + stageTemplate.targetHours) and
  // recomputed whenever a hold period ends — the domain-tat service owns
  // that math, not the schema.
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  holdPeriods      TatHoldPeriod[]
  escalationEvents EscalationEvent[]

  @@index([organizationId, status])
  @@index([incidentId])
  @@index([claimId])
  @@map("case_stage_instances")
}

enum ResponsibleParty {
  DEPOT
  CLAIMS_TEAM
  SURVEYOR
  WORKSHOP
  CUSTOMER
  INSURER
  OTHER
}

// PR-02: on-hold periods with reason and responsible party; TAT-elapsed
// calculations exclude held time (domain-tat service, not the schema).
model TatHoldPeriod {
  id                  String            @id @default(uuid())
  caseStageInstanceId String
  caseStageInstance   CaseStageInstance @relation(fields: [caseStageInstanceId], references: [id])
  reason              String
  responsibleParty    ResponsibleParty
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  createdById         String
  createdBy           User              @relation("TatHoldPeriodCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())

  @@index([caseStageInstanceId])
  @@map("tat_hold_periods")
}

enum EscalationChannel {
  EMAIL
  WHATSAPP
  SMS
}

// PR-03: automatic, configurable escalation hierarchy. Actually firing
// these (and logging what fired) is M13 — this table is the configuration
// only.
model EscalationRule {
  id                         String            @id @default(uuid())
  organizationId             String
  organization               Organization      @relation(fields: [organizationId], references: [id])
  stageTemplateId            String
  stageTemplate              TatStageTemplate  @relation(fields: [stageTemplateId], references: [id])
  escalationLevel            Int // 1 = first escalation, 2 = next level up, ...
  triggerAfterHoursBeyondTat Int // hours past the stage's TAT before this level fires
  notifyRole                 UserRole?
  notifyUserId               String?
  notifyUser                 User?             @relation("EscalationRuleNotifyUser", fields: [notifyUserId], references: [id])
  channel                    EscalationChannel @default(EMAIL)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  escalationEvents EscalationEvent[]

  @@unique([stageTemplateId, escalationLevel])
  @@map("escalation_rules")
}

// M13: one row per (stage instance, rule) that has actually fired — what
// M2b's own EscalationRule comment anticipated ("actually firing these,
// and logging what fired, is M13"). The unique constraint is what stops
// the reminder scheduler from re-notifying the same level every tick;
// lib/escalations/scan.ts checks it before firing and relies on it as a
// backstop against a duplicate insert either way.
model EscalationEvent {
  id                  String            @id @default(uuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id])
  caseStageInstanceId String
  caseStageInstance   CaseStageInstance @relation(fields: [caseStageInstanceId], references: [id])
  escalationRuleId    String
  escalationRule      EscalationRule    @relation(fields: [escalationRuleId], references: [id])
  channel             EscalationChannel
  // Recipient addresses at fire time — a snapshot, not a live join to
  // User (a role's membership can change after the fact; this row
  // records who was actually notified).
  notifiedEmails      String[]
  firedAt             DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@unique([caseStageInstanceId, escalationRuleId])
  @@index([organizationId])
  @@map("escalation_events")
}

// ---------------------------------------------------------------------------
// Settlement & payment (BR-09: a claim cannot be finally closed until
// settlement/payment requirements are satisfied — enforced in the
// domain-settlement service, not here)
// ---------------------------------------------------------------------------

// M19: JBM is the insured, not an approving authority — the insurer
// settles the claim, the surveyor recommends the loss. Settlement.status
// records JBM's *response* to the insurer's settlement offer, not a
// financial approval decision. No monetary approval ceiling exists (or
// should be added) anywhere in this system — see docs/PAYMENTS.md.
enum SettlementStatus {
  PENDING
  ACCEPTED
  DISPUTED
  REVIEW_REQUESTED
}

model Settlement {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  claimId          String
  claim            Claim            @relation(fields: [claimId], references: [id])
  // Multiple settlements per claim are allowed (e.g. an interim payment
  // followed by a final one) rather than forcing exactly one.
  settlementAmount Decimal          @db.Decimal(14, 2)
  currency         String           @default("INR") @db.Char(3)
  status           SettlementStatus @default(PENDING)
  respondedById    String?
  respondedBy      User?            @relation("SettlementRespondedBy", fields: [respondedById], references: [id])
  respondedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  payments Payment[]

  @@index([claimId])
  @@map("settlements")
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

model Payment {
  id               String        @id @default(uuid())
  settlementId     String
  settlement       Settlement    @relation(fields: [settlementId], references: [id])
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @default("INR") @db.Char(3)
  paymentDate      DateTime
  paymentReference String?
  paymentMethod    PaymentMethod @default(BANK_TRANSFER)
  reconciled       Boolean       @default(false)
  reconciledAt     DateTime?
  reconciledById   String?
  reconciledBy     User?         @relation("PaymentReconciledBy", fields: [reconciledById], references: [id])
  createdAt        DateTime      @default(now())

  @@index([settlementId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Audit trail (BR-08: every important action creates an audit record)
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  OTHER
}

enum AuditSourceChannel {
  WEB
  API
  WHATSAPP
  SYSTEM
  WORKER
}

model AuditLog {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  entityType     String // e.g. "Incident", "Vehicle" — no DB FK, see note at top of file
  entityId       String
  action         AuditAction
  actorId        String?
  actor          User?              @relation("AuditLogActor", fields: [actorId], references: [id])
  beforeData     Json?
  afterData      Json?
  sourceChannel  AuditSourceChannel
  createdAt      DateTime           @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Human-readable ID generation (INC-2026-000001, CLM-2026-000001, ...)
// ---------------------------------------------------------------------------

model IdCounter {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String // "INCIDENT" | "CLAIM" | "SURVEY" | ...
  year           Int
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entityType, year])
  @@map("id_counters")
}
