# CM FIM System — environment configuration
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# This file only lists variables actually read by code that exists today
# (M1 — Foundations: Postgres, Redis, S3-compatible storage plumbing; M3 —
# Auth & RBAC: session signing; M5 — Document repository: the S3_* vars
# below are now actually used, not just plumbed through; M11 — OCR: see
# OCR_PROVIDER below, and REDIS_URL is now needed by the app itself, not
# just the worker, since completing an upload enqueues a real job; M13 —
# Escalations: see EMAIL_PROVIDER below). Remaining adapter credentials
# (WhatsApp, telematics) are added here as each integration milestone
# lands (M10, M12) — see docs/SCOPE.md — not pre-declared ahead of the
# code that would use them.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL via Prisma) ---
# Local dev (running `npm run dev` on the host, against docker-compose's
# postgres service published on localhost:5432):
DATABASE_URL="postgresql://cmfim:cmfim@localhost:5432/cmfim?schema=public"

# --- Jobs / cache (Redis via BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (M3) ---
# Signs the session cookie (jose/HS256). Generate a real one per
# environment with: openssl rand -base64 32
# Never reuse this example value outside local dev.
SESSION_SECRET="dev-only-change-me-CM6E3q9y7oGZbP2xVn8sRfL4kAtWc1dJ"

# --- docker-compose service credentials ---
# Used by docker-compose.yml to configure the postgres/minio containers
# themselves, and to build the in-network DATABASE_URL/REDIS_URL/S3_*
# values the app/worker containers use (which point at service names like
# "postgres"/"redis"/"minio", not localhost).
POSTGRES_USER=cmfim
POSTGRES_PASSWORD=cmfim
POSTGRES_DB=cmfim

# --- Object storage (S3-compatible; MinIO locally, AWS S3 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=cmfim
S3_SECRET_ACCESS_KEY=cmfim12345
S3_BUCKET=cm-fim-documents
# MinIO needs path-style URLs (bucket.s3.amazonaws.com doesn't resolve
# locally); leave true for MinIO, set false for AWS S3 in production.
S3_FORCE_PATH_STYLE=true
# Optional (M5): max upload size in bytes. Defaults to 100MB if unset —
# see docs/DOCUMENTS.md.
# DOCUMENT_MAX_FILE_SIZE_BYTES=104857600

# --- OCR (M11) ---
# "stub" (the default if unset) is a real, deterministic adapter — no
# external calls, no AWS credentials needed. A real Textract adapter is a
# follow-up once AWS credentials are confirmed for JBM; setting this to
# anything else today fails closed (see docs/OCR.md) rather than
# silently falling back to fake data.
# OCR_PROVIDER=stub

# --- Email / escalations (M13) ---
# "console" (the default if unset) is a real adapter — logs the message
# rather than sending it, no SMTP credentials needed. A real SES/SendGrid
# adapter is a follow-up once JBM's email sending setup is decided;
# setting this to anything else today fails closed (see
# docs/ESCALATIONS.md) rather than silently pretending to send.
# EMAIL_PROVIDER=console
